# RideIQ Environment Configuration
# DO NOT commit real secrets to version control.

# Server
NODE_ENV=development
PORT=56181
MCP_TRANSPORT=stdio          # stdio | streamable-http

# JWT / Auth (generate strong secrets in production)
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=8h

# Database
DATABASE_URL="postgresql://rideiq:rideiq@localhost:5432/rideiq?schema=public"

# Redis (optional — for caching/rate limiting)
REDIS_URL=redis://localhost:6379

# Optional external integrations (disabled by default — mocks used)
MAPS_API_BASE_URL=
MAPS_API_KEY=
DISPATCH_API_BASE_URL=
DISPATCH_API_KEY=
CRM_API_BASE_URL=
CRM_API_KEY=
NOTIFICATIONS_API_BASE_URL=
NOTIFICATIONS_API_KEY=
SAFETY_SERVICES_API_BASE_URL=
SAFETY_SERVICES_API_KEY=

# Security
ENCRYPTION_KEY=replace-with-a-random-32-byte-key
ALLOWED_ORIGINS=http://localhost:56181

# Simulation
SIMULATION_DEFAULT_SEED=42
SIMULATION_MAX_HORIZON_MINUTES=1440
